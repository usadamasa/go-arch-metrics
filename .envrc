# spm-go はローカルレジストリ (aqua/registry.yaml) 由来で、aqua v2 は既定で拒否する (code 002)｡
# 許可を宣言した policy を渡す｡Taskfile の lint も同じものを渡しているが、baseline.sh のように
# task を通さずに呼ぶ経路のためにここでも設定する｡
export AQUA_POLICY_CONFIG="$PWD/aqua/policy.yaml"

use_aqua() {
  PATH_add "$(aqua root-dir)/bin"
  watch_file aqua.yaml aqua/registry.yaml aqua/policy.yaml
  aqua install -l
}

has aqua && use aqua
